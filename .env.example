# Copy to .env (gitignored) and fill. Secrets live in the environment only.
# Never commit .env. Never hardcode a key in source or config.

# --- Extraction providers (config/providers.yaml maps these to adapters) ---

# Cloud OCR-native: AWS Textract
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2

# Cloud OCR-native: Google Document AI (path to a service-account JSON)
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=
GCP_DOCAI_PROCESSOR_ID=
GCP_DOCAI_LOCATION=us

# Cloud OCR-native: Azure Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Specialist OCR: Mistral
MISTRAL_API_KEY=

# LLM-native extractor and premium region verifier (frontier multimodal)
ANTHROPIC_API_KEY=

# Open-weights engine we run ourselves. Local endpoint; no key leaves the box.
OPENWEIGHTS_ENDPOINT=http://127.0.0.1:8000

# --- Spend guard (ADR-0008) ---
# Total experiment budget: $100. The ledger refuses any call that would cross it.
VERUMETRIC_SPEND_LIMIT_USD=100
VERUMETRIC_SPEND_LEDGER=data/runs/spend.jsonl
